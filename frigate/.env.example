# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# TZ=UTC

## Optional: sizing depends on camera resolution/count, see
## https://docs.frigate.video/frigate/installation#calculating-required-shm-size
# FRIGATE_SHM_SIZE=512M
# FRIGATE_TMPFS_SIZE=1G
