# The directory that config/ and data/ live under. Defaults to ./.
# For any other location, create the directory tree there manually.
# BASE_DIR=

# PUID=1000
# PGID=1000

# TZ=UTC

## Optional: Minecraft version
# VERSION=LATEST

# MARIADB_DATABASE=minecraft
# MARIADB_USER=minecraft
# MARIADB_PASSWORD=minecraft
# MARIADB_ROOT_PASSWORD=minecraft

## Optional: Docker resource limits
# PROXY_CPU_LIMIT=4
# PROXY_MEM_LIMIT=2G
# SERVER_CPU_LIMIT=4
# SERVER_MEM_LIMIT=10G
